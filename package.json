{
  "name": "hiinformer",
  "version": "1.0.2",
  "description": "Easy-to-use, non-intrusive toast notifications for your application.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "dist/index.cjs",
    "dist/index.mjs"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --globalName notify --dts && cpy 'src/**/*.css' dist",
    "publish-package": "npm publish --access public",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "toast notification",
    "alert message",
    "user feedback",
    "popup",
    "dismissable",
    "non-intrusive",
    "system messages",
    "ui component",
    "customizable"
  ],
  "author": "Hein Htet Aung",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.7.2",
    "cpy-cli": "^6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
