{
  "name": "hiinformer",
  "version": "3.0.2",
  "description": "Ultra-sleek Glass UI toast notifications and confirm dialogs in a zero-config single package.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles/*": "./dist/styles/*"
  },
  "sideEffects": [
    "**/*.css",
    "dist/index.js",
    "dist/index.mjs"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --globalName notify --dts && cpy 'src/**/*.css' dist && cpy 'dist/index.global.js' demo",
    "publish-package": "npm publish --access public",
    "test": "echo \"No tests\""
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "toast notification",
    "alert message",
    "user feedback",
    "popup",
    "dismissable",
    "non-intrusive",
    "system messages",
    "ui component",
    "customizable"
  ],
  "author": "Hein Htet Aung",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.7.2",
    "cpy-cli": "^6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
